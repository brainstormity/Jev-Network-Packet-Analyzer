# ==============================================================================
# NetworkSentinel Environment Configuration
# ==============================================================================

# --- TypeSafe Jev Decision Engine ---
# Your TypeSafe API Key (obtained from https://typesafe.ai)
TYPESAFE_API_KEY=your_typesafe_jev_key_here
# Jev Decision Endpoint (Standard: https://api.typesafe.ai/v1/systemone, Fallback: https://thejevai.com/v1/systemone)
JEV_API_URL=https://api.typesafe.ai/v1/systemone
# Model name (default: jev-latest)
JEV_MODEL=jev-latest

# --- Network Sniffing & Interface ---
# Target network interface to monitor (e.g. eth0, en0, any, or leave empty for auto-detect)
CAPTURE_INTERFACE=
# BPF filter string for kernel-level noise rejection
BPF_FILTER=ip and not net 127.0.0.0/8 and not udp port 5353 and not udp port 1900 and not port 6379 and not port 8000

# --- Redis Message Broker & Deduplication Cache ---
# Connection URI for Redis
REDIS_URL=redis://localhost:6379/0

# --- Security Alert Thresholds ---
# Noul confidence threshold (0.0 to 1.0) indicating suspicious activity
ALERT_THRESHOLD_NOUL=0.85
# Minimum integer severity score (0 to 4) required to trigger an alert
ALERT_MIN_SEVERITY=3

# --- Resend Email Notification Engine ---
# Your Resend API Key (starts with re_...) from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# SENDER EMAIL (FROM address):
# • Option A (NO DOMAIN NEEDED): Use Resend's free testing address:
#   RESEND_FROM_EMAIL=onboarding@resend.dev
#   (Requirement: ALERT_RECIPIENT below MUST be the email address you signed up to Resend with)
# • Option B (CUSTOM DOMAIN): If you verified a domain at https://resend.com/domains:
#   RESEND_FROM_EMAIL=security@yourdomain.com (can send to any email address)
RESEND_FROM_EMAIL=onboarding@resend.dev

# DESTINATION EMAIL: Where threat alerts should be sent
ALERT_RECIPIENT=your_notification_email@gmail.com

# --- Local Storage & Operational Options ---
# SQLite database filename
DATABASE_PATH=network_sentinel.db
# Enable mock simulation if running without network interfaces or API keys
SIMULATION_MODE=false
